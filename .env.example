# Copy to .env and adjust. Generate secrets with: openssl rand -hex 32

# Master key for the LiteLLM gateway / management API (must start with "sk-").
LITELLM_MASTER_KEY=sk-

# Encrypts credentials stored in the database. Never change it after first use,
# or stored credentials become unreadable.
LITELLM_SALT_KEY=sk-

# Virtual key used by the MCP server to call LiteLLM (must start with "sk-").
# Register it once after LiteLLM is up with: ./scripts/create-mcp-key.sh
MCP_LITELLM_API_KEY=sk-

# Postgres password (use hex characters only; it is embedded in a URL).
POSTGRES_PASSWORD=

# Admin UI login at https://llm.simovi.org
UI_USERNAME=admin
UI_PASSWORD=

# Space-separated Ollama models pulled by `ollama-pull`.
OLLAMA_MODELS="gemma4:e4b embeddinggemma"
OLLAMA_KEEP_ALIVE=30m

# Dev only: host ports on 127.0.0.1 (see compose.dev.yml).
LITELLM_PORT=4000
MCP_PORT=8000
OLLAMA_PORT=11435


# Public hostnames routed by Traefik.
LLM_HOST=llm.simovi.org
MCP_HOST=mcp.simovi.org

# Must match your external Traefik configuration.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
